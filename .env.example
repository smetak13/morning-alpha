FMP_API_KEY=your_fmp_api_key
OPENAI_API_KEY=your_openai_api_key

# Neon/Postgres. Copy the pooled connection string from Neon Console > Connect.
# Neon requires TLS; keep sslmode=require in the URL.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Neon Auth. Copy the Auth URL from Neon Console after enabling Auth.
# The VITE_* name is intended for a future frontend; the Python CLI only validates it for now.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace_with_at_least_32_random_chars
NEON_AUTH_EMAIL_PASSWORD_ENABLED=true
NEON_AUTH_GOOGLE_OAUTH_ENABLED=true
NEON_AUTH_TIMEOUT_SECONDS=15

# Comma-separated frontend origins that may call the FastAPI server with cookies.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
API_RUN_MIGRATIONS_ON_STARTUP=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=you@example.com
